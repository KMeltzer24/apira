# Required by user-service and portfolio-service.
# Local Docker (docs/run-locally.md):
DATABASE_URL=postgresql+psycopg2://apira:apira@localhost:5432/apira
# EC2 / RDS:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/apira

# Structured logging defaults for local Docker Compose.
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development
