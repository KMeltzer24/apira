# PostgreSQL connection shared by user-service and portfolio-service.
# Copy this file to .env and fill in your real values. The .env file is gitignored.
#
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
#
# AWS RDS requires SSL, so add ?sslmode=require to the URL. Example:
#   DATABASE_URL=postgresql+psycopg2://postgres:secret@your-instance.us-east-2.rds.amazonaws.com:5432/postgres?sslmode=require

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/apira
