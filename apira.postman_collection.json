{
  "info": {
    "name": "Apira",
    "description": "Enterprise microservices system. User Service (8001) and Portfolio Service (8002). Data stored in PostgreSQL on AWS RDS. Default URLs point at the EC2 deployment; switch collection variables to localhost for local dev.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "User Service",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/login",
              "host": ["{{userServiceUrl}}"],
              "path": ["login"]
            },
            "description": "Validates username/password against the users table. Returns user_id on success; 401 on invalid credentials."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Portfolio Service",
      "item": [
        {
          "name": "Get Portfolio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{portfolioServiceUrl}}/portfolio?user_id={{userId}}",
              "host": ["{{portfolioServiceUrl}}"],
              "path": ["portfolio"],
              "query": [
                { "key": "user_id", "value": "{{userId}}" }
              ]
            },
            "description": "Returns holdings for the given user_id from the portfolios table. Use user_id from the login response (alice=1, bob=2)."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "userServiceUrl", "value": "http://18.188.213.146:8001" },
    { "key": "portfolioServiceUrl", "value": "http://18.188.213.146:8002" },
    { "key": "userId", "value": "1" }
  ]
}
