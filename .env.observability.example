# Copy to .env.observability on EC2 (never commit real tokens).
#
# Grafana Cloud → your stack → Loki → "Send logs" / Alloy instructions.
# Typical values:
#   GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
#   GRAFANA_LOKI_USER=<numeric instance id>
#   GRAFANA_LOKI_API_KEY=<Cloud Access Policy token with logs:write>

GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=
GRAFANA_LOKI_API_KEY=

ENVIRONMENT=production
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to POST logs (use * for demos).
CORS_ALLOW_ORIGINS=*
